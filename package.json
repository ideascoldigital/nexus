{
  "name": "nexux",
  "version": "0.1.8",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ideascoldigital/nexus.git"
  },
  "bugs": "https://github.com/ideascoldigital/nexus/issues",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "turbo run dev --filter=@nexux/web",
    "dev:native": "pnpm --filter @nexux/native dev",
    "build": "turbo run build",
    "build:native": "pnpm --filter @nexux/native tauri:build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "turbo run db:migrate --filter=@nexux/web",
    "clean": "turbo run clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "better-sqlite3",
      "esbuild",
      "msw",
      "node-pty",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
