{
  "name": "@nexux/storage",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./adapter": "./src/adapter.ts",
    "./adapters/local": "./src/adapters/local.ts",
    "./context-builder": "./src/context-builder.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-exclude=\"**/*.test.ts\" --test-coverage-lines=91 --test-coverage-branches=86 --test-coverage-functions=89 \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@nexux/config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
