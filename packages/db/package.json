{
  "name": "@nexux/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/generated/client.ts",
    "./types": "./src/generated/client.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-exclude=\"**/*.test.ts\" --test-coverage-exclude=\"**/generated/**\" --test-coverage-lines=89 --test-coverage-branches=86 --test-coverage-functions=88 \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@nexux/config": "workspace:*",
    "@prisma/adapter-better-sqlite3": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "better-sqlite3": "^12.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "dotenv": "^17.3.1",
    "prisma": "^7.6.0",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
