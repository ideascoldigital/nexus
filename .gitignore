# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
# pnpm-only monorepo — a stray `bun install` must not commit its lockfile
bun.lock*
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# turbo
.turbo

# testing
coverage

# next.js
.next/
out/

# production
build
dist

# rust / tauri
target/
**/src-tauri/gen/
**/src-tauri/sidecar/
**/src-tauri/sidecar-build/
**/src-tauri/binaries/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
**/generated/prisma

# database
#
# The whole directory, not a list of extensions: CloudCredential.data and
# ProjectEnvVar.value are stored as plaintext (ENCRYPTION_KEY is read in
# @nexux/config and consumed by nothing), so this file holds live cloud keys
# and git tokens. `*.db` alone missed a `dashboard.db.bak-20260919` sitting
# next to it, which one `git add -A` would have published.
**/data/

# claude local — everything except the shared harness (hooks + their config)
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/settings.local.json
