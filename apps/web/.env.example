# Database
DATABASE_URL=file:./data/dashboard.db

# Encryption Key for storing API keys (generate a random 32-character string)
# Use: openssl rand -hex 32
ENCRYPTION_KEY=your_encryption_key_here

# Codex API Configuration (Optional - defaults to https://api.codex.com/v1)
CODEX_API_URL=https://api.codex.com/v1

# Agents Generator SDK (Optional - defaults to https://api.agentsgenerator.dev)
AGENTS_GENERATOR_API_URL=https://api.agentsgenerator.dev
