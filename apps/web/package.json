    "@modelcontextprotocol/sdk": "1.30.0",
    "@nexux/config": "workspace:*",
    "@nexux/core": "workspace:*",
    "@nexux/db": "workspace:*",
    "@nexux/embeddings": "workspace:*",
    "@nexux/harness": "workspace:*",
    "@nexux/llm": "workspace:*",
    "@nexux/mcp": "workspace:*",
    "@nexux/sandbox": "workspace:*",
    "@nexux/storage": "workspace:*",
    "@nexux/terminal": "workspace:*",
