{
  "name": "@nexux/web",
  "version": "0.1.8",
  "private": true,
  "scripts": {
    "dev": "cross-env NEXUX_WEB_ORIGIN=http://localhost:3333 next dev --turbopack -p 3333",
    "dev:next": "cross-env NEXUX_WEB_ORIGIN=http://localhost:3333 next dev --turbopack -p 3333",
    "dev:terminal": "pnpm --filter @nexux/terminal dev:terminal",
    "dev:server": "pnpm --filter @nexux/terminal dev:server",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "db:migrate": "pnpm --filter @nexux/db db:migrate",
    "stack:backfill-phases": "tsx --env-file=.env scripts/backfill-phases.ts",
    "db:generate": "pnpm --filter @nexux/db generate"
  },
  "dependencies": {
